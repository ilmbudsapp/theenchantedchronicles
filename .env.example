# =============================================================================
# Environment variables — theenchantedchronicles (Vercel + local)
# Copy to .env.local for development:  cp .env.example .env.local
# Add the same keys in Vercel → Project → Settings → Environment Variables
# =============================================================================

# --- EmailJS (contact form on /kontakt) ---
# Required for contact form submissions from the browser.
# Create a free account at https://www.emailjs.com/
# Dashboard → Email Services / Email Templates / Account → Public Key
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# --- Google Analytics (optional) ---
# Loads ONLY after cookie consent (DSGVO). Leave empty to disable GA.
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Vercel serverless contact fallback (optional) ---
# Used by /api/contact.ts if you enable SMTP instead of EmailJS-only.
# Set in Vercel only (NOT NEXT_PUBLIC_ — server-side secrets):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# CONTACT_TO_EMAIL=
